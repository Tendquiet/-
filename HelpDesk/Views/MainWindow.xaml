<Window x:Class="HelpDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk - Заявки"
        Height="600"
        Width="1000"
        MinHeight="500"
        MinWidth="850"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D6CDF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="*" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="HelpDesk" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Система обработки заявок" FontSize="14" Opacity="0.7" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="CurrentUserTextBlock"
                           Text="Пользователь: admin"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>
                <Button x:Name="LogoutButton"
                        Content="Выйти"
                        ToolTip="Выйти из учетной записи"
                        Width="80"
                        Height="30"
                        Click="LogoutButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Поиск" 
                         Margin="0,0,0,5"/>
                <TextBox x:Name="SearchTextBox"
                         ToolTip="Введите текст для поиска"
                         Height="31"
                         FontSize="14"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Статус"
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="StatusComboBox"
                          ToolTip="Выберите статус для фильтрации"
                          Height="32"
                          FontSize="16"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Новая"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Выполнена"/>
                    <ComboBoxItem Content="Отклонена"/>
                </ComboBox>
            </StackPanel>

            <Button x:Name="SearchButton"
                    Grid.Column="4"
                    Content="Найти"
                    ToolTip="Найти заявки"
                    Height="32"
                    VerticalAlignment="Bottom"
                    Click="SearchButton_Click"/>

            <Button x:Name="ResetFilterButton"
                    Grid.Column="6"
                    Content="Сбросить"
                    ToolTip="Сбросить фильтры"
                    Height="32"
                    VerticalAlignment="Bottom"
                    Click="ResetFilterButton_Click"/>
        </Grid>

        <DataGrid x:Name="TicketsDataGrid"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F4F6F9"
                  RowHeight="30"
                  CanUserResizeRows="False"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="140"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="6"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button x:Name="AddTicketButton"
            Content="Добавить"
            ToolTip="Добавить новую заявку"
            Width="110"
            Height="35"
            Margin="5"
            Click="AddTicketButton_Click"/>

            <Button x:Name="EditTicketButton"
            Content="Редактировать"
            ToolTip="Редактировать выбранную заявку"
            Width="120"
            Height="35"
            Margin="5"
            Click="EditTicketButton_Click"/>

            <Button x:Name="DeleteTicketButton"
            Content="Удалить"
            ToolTip="Удалить выбранную заявку"
            Background="#D9534F"
            Width="110"
            Height="35"
            Margin="5"
            Click="DeleteTicketButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
