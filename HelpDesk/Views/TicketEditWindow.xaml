<Window x:Class="HelpDesk.Views.TicketEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HelpDesk.Views"
        mc:Ignorable="d"
        Title="HelpDesk — Редактирование заявки" 
        Height="600" 
        Width="450"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Редактирование заявки" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"/>

        <TextBlock x:Name="IdTextBlock"
                   Grid.Row="2" 
                   Text="Заявка №: 0" 
                   FontSize="14" 
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="4" 
                   Text="Категория" 
                   FontSize="12" 
                   Opacity="0.7" 
                   Margin="0,0,0,5"/>

        <ComboBox x:Name="CategoryComboBox"
                  Grid.Row="5"
                  Height="35"
                  FontSize="14"
                  SelectedIndex="0">
            <ComboBoxItem Content="Выберите категорию" IsEnabled="False"/>
            <ComboBoxItem Content="Оборудование"/>
            <ComboBoxItem Content="Программное обеспечение"/>
            <ComboBoxItem Content="Сеть"/>
            <ComboBoxItem Content="Учётная запись"/>
            <ComboBoxItem Content="Периферия"/>
            <ComboBoxItem Content="Другое"/>
        </ComboBox>

        <TextBlock Grid.Row="7" 
                   Text="Описание" 
                   FontSize="12" 
                   Opacity="0.7" 
                   Margin="0,0,0,5"/>

        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="8"
                 FontSize="14"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalContentAlignment="Top"
                 Padding="5"/>

        <TextBlock Grid.Row="10" 
                   Text="Приоритет" 
                   FontSize="12" 
                   Opacity="0.7" 
                   Margin="0,0,0,5"/>

        <ComboBox x:Name="PriorityComboBox"
                  Grid.Row="11"
                  Height="35"
                  FontSize="14"
                  SelectedIndex="1">
            <ComboBoxItem Content="Низкий"/>
            <ComboBoxItem Content="Средний"/>
            <ComboBoxItem Content="Высокий"/>
        </ComboBox>

        <TextBlock Grid.Row="13" 
                   Text="Статус" 
                   FontSize="12" 
                   Opacity="0.7" 
                   Margin="0,0,0,5"/>

        <ComboBox x:Name="StatusComboBox"
                  Grid.Row="14"
                  Height="35"
                  FontSize="14"
                  SelectedIndex="0">
            <ComboBoxItem Content="Новая"/>
            <ComboBoxItem Content="В работе"/>
            <ComboBoxItem Content="Выполнена"/>
            <ComboBoxItem Content="Отклонена"/>
        </ComboBox>

        <Grid Grid.Row="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SaveButton"
                    Grid.Column="0"
                    Content="Сохранить изменения"
                    Height="35"
                    FontSize="14"/>

            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Content="Отмена"
                    Height="35"
                    FontSize="14"/>
        </Grid>
    </Grid>
</Window>

